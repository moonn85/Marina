{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2017",
    "outDir": "./dist",
    "baseUrl": "./",              // 👈 thêm dòng này
    "paths": {                    // 👈 và phần này
      "src/*": ["./src/*"]
    },
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true
  }
}